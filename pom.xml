<project xmlns="https://maven.apache.org/POM/4.0.0"
	xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>PandaUtils</groupId>
	<artifactId>PandaUtils</artifactId>
	<version>0.0.1 Alpha</version>
	<packaging>pom</packaging>
	<name>PandaUtils</name>
	<description>Utilities for Spigot by DarkPanda73</description>
	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>
	<modules>
		<module>PandaAPIs</module>
		<module>PandaBStats</module>
		<module>PandaColors</module>
		<module>PandaCommandsModule</module>
		<module>PandaFilesModule</module>
		<module>PandaHTTPServer</module>
		<module>PandaHTTPServerModule</module>
		<module>PandaInventories</module>
		<module>PandaPermissionsModule</module>
		<module>PandaPlayerDataModule</module>
		<module>PandaPlugin</module>
		<module>PandaRecipes</module>
		<module>PandaSQLModule</module>
		<module>PandaThreads</module>
		<module>PandaUtilities</module>
		<module>PandaYaml</module>
		<module>PandaIRCClient</module>
		<module>PandaTwitchIRCClient</module>
		<module>PandaJavaUtilities</module>
		<module>PandaUpdateChecker</module>
		<module>PandaDiscordWebhook</module>
		<module>PandaEventCustomizer</module>
		<module>PandaLoggingModule</module>
		<module>PandaMessageListenerModule</module>
        <module>PandaInputListenerModule</module>
		<module>PandaEconomiesModule</module>
		<module>PandaCachedPlayersModule</module>
		<module>PandaBossBarModule</module>
		<module>PandaHologramsModule</module>
		<module>PandaFakeEntitiesModule</module>
        <module>PandaJSON</module>
		<module>ReflectionsFork</module>
	</modules>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>